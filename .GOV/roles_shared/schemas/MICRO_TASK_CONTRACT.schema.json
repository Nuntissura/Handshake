{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsk.microtask_contract@1",
  "title": "Handshake Microtask Contract",
  "type": "object",
  "required": ["schema_id", "schema_version", "contract_authority", "wp_id", "mt_id", "authority_files", "markdown_projection", "lifecycle", "scope", "red_team"],
  "properties": {
    "schema_id": { "const": "hsk.microtask_contract@1" },
    "schema_version": { "type": "string", "minLength": 1 },
    "contract_authority": { "const": "PRIMARY_MACHINE_READABLE" },
    "artifact_policy": { "$ref": "#/$defs/artifact_policy" },
    "wp_id": { "type": "string", "pattern": "^WP-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "mt_id": { "type": "string", "pattern": "^(MT-)?[0-9][0-9A-Za-z._-]*$" },
    "created_at_utc": { "type": "string" },
    "updated_at_utc": { "type": ["string", "null"] },
    "authority_files": { "type": "object", "required": ["microtask_contract", "microtask_projection", "packet_contract"], "additionalProperties": { "type": "string" } },
    "markdown_projection": { "$ref": "#/$defs/markdown_projection" },
    "lifecycle": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" }, "depends_on": { "type": "array", "items": { "type": "string" } }, "active": { "type": "boolean" } }, "additionalProperties": true },
    "scope": { "type": "object" },
    "resource_privacy_obligation": { "$ref": "#/$defs/resource_privacy_obligation" },
    "handoff": { "type": "object" },
    "red_team": { "$ref": "#/$defs/red_team" }
  },
  "additionalProperties": true,
  "$defs": {
    "artifact_policy": {
      "type": "object",
      "properties": {
        "authority_surface": { "const": "MACHINE_CONTRACT" },
        "legacy_markdown_policy": { "const": "SAFETY_NET_ONLY_DO_NOT_COPY_FORWARD" },
        "projection_creation": { "enum": ["ON_DEMAND_OR_CONTRACT_BOUND", "ON_OPERATOR_REQUEST_ONLY"] },
        "operator_facing_authority": { "const": false },
        "model_created_markdown_authority_allowed": { "const": false },
        "allowed_markdown_exceptions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "markdown_projection": { "type": "object", "required": ["path", "status"], "properties": { "path": { "type": "string" }, "status": { "enum": ["GENERATED_PENDING", "GENERATED_IN_SYNC", "NOT_MATERIALIZED", "NOT_GENERATED_BY_DEFAULT", "LEGACY_AUTHORITY", "BLOCKED"] } }, "additionalProperties": true },
    "red_team": { "type": "object", "required": ["required", "profile"], "properties": { "required": { "const": true }, "profile": { "enum": ["DETERMINISTIC_CONTRACT_MIGRATION_V1", "ACCOUNT_RESOURCE_PRIVACY_PREACTIVATION_V1"] } }, "additionalProperties": true },
    "resource_privacy_obligation": {
      "type": "object",
      "required": ["required", "resources_touched", "expected_evidence"],
      "properties": {
        "required": { "const": true },
        "applicable": { "type": ["boolean", "string", "null"] },
        "resources_touched": { "type": "array" },
        "expected_evidence": { "type": "array", "items": { "type": "string" } },
        "not_applicable_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}

