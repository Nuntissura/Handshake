  "usage_contract": {
    "purpose": "Machine-readable module resolver for tools and LLMs to locate the owning indexed Master Spec module before reading or editing spec content.",
    "manifest_is_hash_authority": true,
    "index_is_resolver_authority": true,
    "not_a_document_viewer": true,
    "not_operator_facing": true,
    "module_body_rule": "module files carry machine-readable frontmatter followed by Master Spec body text; source baseline provenance remains in manifest metadata",
    "versioning_rule": "SPEC_CURRENT resolves the active versioned bundle; do not infer current authority from latest monolith filename or archive folder name",
    "internal_reference_rule": "Internal Master Spec references to the active spec must name SPEC_CURRENT, active bundle manifest/modules, and spec-changelog.jsonl rather than legacy latest-file wording."
  },
  "roadmap_authority_boundary": {
    "module_path": "spec-modules/07-6-development-roadmap.md",
    "role": "north_star_sequence_guide",
    "drives": [
      "task_board_scheduling",
      "work_packet_scheduling",
      "micro_task_scheduling"
    ],
    "does_not_define": [
      "implementation_intent",
      "implementation_techniques",
      "SPEC_ANCHOR",
      "DONE_MEANS",
      "validation_proof"
    ],
    "topical_authority_rule": "Work intent, techniques, SPEC_ANCHOR, DONE_MEANS, and validation proof must be derived from the relevant topical Master Spec module, not from roadmap text alone.",
    "missing_topical_authority_rule": "If a roadmap item lacks topical Master Spec authority, activation requires spec enrichment before a Task Board item, Work Packet, or micro-task can treat it as implementable scope."
  },
