  "scope": {
    "summary": "Implement custom tape measures on avatar and garment (CG-21, MD Avatar/3D-Garment Tape Measures): typed linear, circumference, and surface tapes authored on avatar or garment meshes, recomputed per frame/drape, plus a measure_garment MCP tool returning named measurement rows - the LLM fit-verification surface per 13.7 §7.1 + 13.13.",
    "allowed_paths": [
      "tailor-solver/src/body/",
      "src/backend/handshake_core/src/tailor/model_api/tools/",
      "src/backend/handshake_core/migrations/"
    ],
    "forbidden_paths": [],
    "acceptance_criteria": [
      "TapeMeasure records (kind linear|circumference|surface; anchor points as mesh barycentric refs; target avatar|garment) persisted (TPM- ids) and recomputed against current pose/drape state.",
      "measure_garment / measure_avatar MCP tools return named tape values in cm plus the 25 standard measurements; deltas vs previous sim run included for fit iteration.",
      "Tapes render as viewport overlays (reuse MT-245 debug overlay path) with stable author_ids; Argus can read values via typed route.",
      "Symmetric tape duplication helper (MD 11 parity)."
    ],
    "proof_targets": [
      "cargo test -p handshake_core tailor::model_api::measure_garment_returns_named_tapes"
    ],
    "risk_if_missed": "Numeric fit verification is how a model proves a garment fits without eyeballing renders; without tapes the self-correction loop regresses to screenshot guessing."
  },
