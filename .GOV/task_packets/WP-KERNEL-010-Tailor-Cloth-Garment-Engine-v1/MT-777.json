      "src/backend/handshake_core/src/tailor/materials/sbsar_connector.rs",
      "src/frontend/handshake_native/src/tailor/pbr_generator.rs",
      "src/frontend/handshake_native/tests/tailor_pbr_generator.rs"
    ],
    "forbidden_paths": [],
    "acceptance_criteria": [
      "Native generation covers base color, normal, height/displacement, roughness, metalness, AO, opacity, masks, channel packing, resolution/tiling, seed, and dependency manifests.",
      "The optional SBSAR connector consumes the MT-782-pinned executable/API/version/hash and fixture profile, exposes parameters and outputs, runs bounded/cancellable, records unsupported/loss state, and fails closed with a typed missing/stale/incompatible-profile blocker without licensing/tool assumptions.",
      "Backend/Argus tests cover native-only operation, parameter sweeps, missing connector, incompatible version, DCC hang, partial bake, color management, stale sources, recovery, and round trip."
    ],
    "proof_targets": [
      "cargo test -p handshake_core tailor_pbr_generator",
      "cargo test -p handshake-native --test tailor_pbr_generator"
    ],
    "risk_if_missed": "Fragmented texture generation and an implicit SBSAR exclusion leave a major professional material workflow unowned."
  },
