DEFINE TABLE IF NOT EXISTS parallel_swarm_state_recovery_authority SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS record_kind ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS aggregate_id ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS workspace_id ON TABLE parallel_swarm_state_recovery_authority TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS wp_id ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS mt_id ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS status ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS scope_kind ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS scope_id ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS exclusive_scope_key ON TABLE parallel_swarm_state_recovery_authority TYPE string VALUE IF ($this.record_kind = 'claim' AND $this.status = 'active') OR ($this.record_kind = 'indexing_lease' AND $this.status = 'acquired') { $this.record_kind + ':' + $this.scope_kind + ':' + $this.scope_id } ELSE { $this.record_kind + ':' + $this.aggregate_id };
DEFINE FIELD IF NOT EXISTS record_json ON TABLE parallel_swarm_state_recovery_authority TYPE string;
DEFINE FIELD IF NOT EXISTS event_ledger_event_id ON TABLE parallel_swarm_state_recovery_authority TYPE record<kernel_event_ledger> ASSERT record::exists($value) REFERENCE ON DELETE REJECT;
DEFINE FIELD IF NOT EXISTS event_payload_hash ON TABLE parallel_swarm_state_recovery_authority TYPE string ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS owner_account_id ON TABLE parallel_swarm_state_recovery_authority TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS actor_principal_id ON TABLE parallel_swarm_state_recovery_authority TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS authenticated_session_id ON TABLE parallel_swarm_state_recovery_authority TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS access_space_id ON TABLE parallel_swarm_state_recovery_authority TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS created_at ON TABLE parallel_swarm_state_recovery_authority TYPE datetime DEFAULT time::now();
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE parallel_swarm_state_recovery_authority TYPE datetime VALUE time::now();
DEFINE INDEX IF NOT EXISTS parallel_swarm_state_recovery_record_scope ON TABLE parallel_swarm_state_recovery_authority FIELDS record_kind, aggregate_id, owner_account_id, actor_principal_id, authenticated_session_id, access_space_id, workspace_id UNIQUE;
DEFINE INDEX IF NOT EXISTS parallel_swarm_state_recovery_workspace_scope ON TABLE parallel_swarm_state_recovery_authority FIELDS workspace_id, wp_id, mt_id, record_kind, owner_account_id, actor_principal_id, authenticated_session_id, access_space_id;
DEFINE INDEX IF NOT EXISTS parallel_swarm_state_recovery_status_scope ON TABLE parallel_swarm_state_recovery_authority FIELDS record_kind, scope_kind, scope_id, status, owner_account_id, actor_principal_id, authenticated_session_id, access_space_id, workspace_id;
DEFINE INDEX IF NOT EXISTS parallel_swarm_state_recovery_exclusive_scope ON TABLE parallel_swarm_state_recovery_authority FIELDS exclusive_scope_key, owner_account_id, actor_principal_id, authenticated_session_id, access_space_id, workspace_id UNIQUE;

DEFINE TABLE IF NOT EXISTS authenticated_resource_context_lifecycle SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner_account_id ON TABLE authenticated_resource_context_lifecycle TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS actor_principal_id ON TABLE authenticated_resource_context_lifecycle TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS authenticated_session_id ON TABLE authenticated_resource_context_lifecycle TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS access_space_id ON TABLE authenticated_resource_context_lifecycle TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS workspace_id ON TABLE authenticated_resource_context_lifecycle TYPE string ASSERT string::trim($value) != '';
DEFINE FIELD IF NOT EXISTS lifecycle_state ON TABLE authenticated_resource_context_lifecycle TYPE 'active' | 'stale' | 'revoked';
DEFINE FIELD IF NOT EXISTS generation ON TABLE authenticated_resource_context_lifecycle TYPE int ASSERT $value > 0;
DEFINE FIELD IF NOT EXISTS revocation_epoch ON TABLE authenticated_resource_context_lifecycle TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE authenticated_resource_context_lifecycle TYPE datetime VALUE time::now();
DEFINE INDEX IF NOT EXISTS authenticated_resource_context_exact_scope ON TABLE authenticated_resource_context_lifecycle FIELDS owner_account_id, actor_principal_id, authenticated_session_id, access_space_id, workspace_id UNIQUE;
